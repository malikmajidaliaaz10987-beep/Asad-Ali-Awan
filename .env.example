# ==============================================================================
# ASAD ALI AWAN PORTFOLIO - ENVIRONMENT CONFIGURATION
# Configure these variables in your hosting environment (e.g. Vercel Project Settings > Environment Variables)
# ==============================================================================

# --- 1. AI CHATBOT (GOOGLE GEMINI) ---
# Your Google Gemini API Key from Google AI Studio (starts with "AIzaSy...").
# Read strictly server-side; never exposed to browser.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# --- 2. EMAIL NOTIFICATIONS & DIRECT EMAIL DISPATCH (RESEND) ---
# Create a free account at https://resend.com and generate an API key (starts with "re_...").
RESEND_API_KEY="re_YourResendApiKeyHere"

# Verified sender email address. For testing, Resend allows "onboarding@resend.dev".
# Once your domain (e.g. asadaliawan.com) is verified in Resend, use e.g. "notifications@asadaliawan.com"
RESEND_FROM_EMAIL="Asad Portfolio <onboarding@resend.dev>"

# Recipient email for contact form submissions and new user registration alerts.
CONTACT_NOTIFICATION_EMAIL="malikmajidaliaa.z10987@gmail.com"

# --- 3. ADMIN SECURITY & DASHBOARD ---
# The authorized administrator email allowed to access the User Directory dashboard.
ADMIN_EMAIL="malikmajidaliaa.z10987@gmail.com"

# Server master secret key to unlock the admin dashboard.
ADMIN_SECRET_KEY="asad_admin_secure_key_2026"

# --- 4. FIREBASE AUTHENTICATION (CLIENT-SIDE) ---
# Obtain from Firebase Console > Project Settings > General > Your Apps (Web App)
# Required for Google Sign-In and live Firebase accounts.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="asad-ali-awan-portfolio.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="asad-ali-awan-portfolio"
VITE_FIREBASE_STORAGE_BUCKET="asad-ali-awan-portfolio.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- 5. APPLICATION URL & CONTACT DEFAULTS ---
APP_URL="https://asadaliawan.netlify.app"
CONTACT_WHATSAPP_NUMBER="+923164227321"

# --- 6. GOOGLE ANALYTICS 4 (OPTIONAL) ---
# Measurement ID from Google Analytics (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""
